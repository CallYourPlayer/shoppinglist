# Development image: matches the Ruby version in .ruby-version / Gemfile
# and includes the system libraries needed to build the `pg` gem.
FROM ruby:3.2.2-slim

# Only what's needed to build the native `pg` gem. libvips/pkg-config are
# omitted because the `image_processing` gem is not used (commented out in the
# Gemfile), and they pull in a huge dependency tree.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential libpq-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /rails

ENV BUNDLE_PATH=/usr/local/bundle

# Gems are installed at runtime into a persistent named volume (see
# docker-compose.dev.yml) so a long `bundle install` is resumable and cached.
# Application code is bind-mounted at runtime.
#CMD ["sleep", "infinity"]
CMD ["bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"]